{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "precision-contact",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "dev": {
      "name": "precision-contact-dev",
      "routes": [{"pattern": "dev.bramwelltest.com/contact-verification/*", "zone_name": "bramwelltest.com"}],
      "vars": {"CONTACT_HOSTNAME": "dev.bramwelltest.com", "TURNSTILE_SITE_KEY": "0x4AAAAAAFzzP7k_8ZUrC97_"}
    },
    "prod": {
      "name": "precision-contact-prod",
      "routes": [{"pattern": "bramwelltest.com/contact-verification/*", "zone_name": "bramwelltest.com"}],
      "vars": {"CONTACT_HOSTNAME": "bramwelltest.com", "TURNSTILE_SITE_KEY": "0x4AAAAAAFzz3Zl0PCks_gH9"}
    }
  }
}
